{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LibreGene",
  "version": "../package.json",
  "identifier": "com.libregene.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "LibreGene",
        "width": 1400,
        "height": 900,
        "minWidth": 960,
        "minHeight": 540,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 14.0, "y": 22.0 }
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": "'self' asset: http://asset.localhost data:",
        "style-src": "'self' 'unsafe-inline' tauri-plugin-decoration: http://tauri-plugin-decoration.localhost https://tauri-plugin-decoration.localhost",
        "style-src-elem": "'self' 'unsafe-inline' tauri-plugin-decoration: http://tauri-plugin-decoration.localhost https://tauri-plugin-decoration.localhost"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../assets/Fonts/*"
    ],
    "fileAssociations": [
      {
        "ext": ["gbk", "gb", "genbank", "gbf", "gbff"],
        "name": "GenBank File",
        "description": "GenBank sequence file",
        "role": "Editor"
      },
      {
        "ext": ["gpt", "gp", "gpe", "gpff", "prot"],
        "name": "Protein Sequence File",
        "description": "GenPept/protein sequence file",
        "role": "Editor"
      },
      {
        "ext": ["dna", "rna"],
        "name": "Sequence File",
        "description": "SnapGene DNA/RNA sequence file",
        "role": "Editor"
      },
      {
        "ext": ["fasta", "fa", "fna", "fas", "ffn", "fsa", "faa", "frn"],
        "name": "FASTA File",
        "description": "FASTA sequence file",
        "role": "Editor"
      },
      {
        "ext": ["ab1"],
        "name": "ABI Trace File",
        "description": "Sanger sequencing trace file",
        "role": "Viewer"
      },
      {
        "ext": ["seq"],
        "name": "Sequence File",
        "description": "Plain sequence file",
        "role": "Editor"
      }
    ]
  }
}
